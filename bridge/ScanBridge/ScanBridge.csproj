<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows 10 1809+; the versioned TFM enables WinRT APIs (StartupTask, ApplicationData) for the Store edition -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WinExe = no console window when launched at logon -->
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>Scan2PdfBridge</AssemblyName>
    <RootNamespace>ScanBridge</RootNamespace>
    <!-- System-tray icon (NotifyIcon) + message boxes -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Shown in the exe's Properties → Details tab -->
    <Product>Scan 2 PDF Bridge</Product>
    <Company>Aghapy Tech Services</Company>
    <Authors>Aghapy Tech Services</Authors>
    <Copyright>© 2026 Aghapy Tech Services. MIT License.</Copyright>
    <Description>Local scanner bridge for the Scan 2 PDF Outlook add-in</Description>
    <Version>1.6.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid clashes between WinForms and ASP.NET implicit usings -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
