{
  "name": "scan-2-pdf-outlook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sideload": "office-addin-debugging start manifest.xml desktop --app outlook --no-debug",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@upstash/redis": "^1.41.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/office-js": "^1.0.400",
    "@types/qrcode": "^1.5.6",
    "office-addin-debugging": "^6.0.0",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "license": "MIT",
  "author": "Aghapy Tech Services (https://aghapyts.com)"
}
